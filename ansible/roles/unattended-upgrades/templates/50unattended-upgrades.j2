// {{ ansible_managed }}
// Security-pocket auto-patching only. Everything else waits for a deliberate
// pass via `ansible-playbook update.yml`. Reboots are never automatic.
//
// Origin patterns differ between Debian (forge-hypervisor, forge-ops) and
// Ubuntu (forge-ai, forge-erp, forge-brizza), so they are templated per host.

Unattended-Upgrade::Allowed-Origins {
{% if ansible_facts['distribution'] == 'Ubuntu' %}
        "${distro_id}:${distro_codename}-security";
        "${distro_id}ESMApps:${distro_codename}-apps-security";
        "${distro_id}ESM:${distro_codename}-infra-security";
{% else %}
        "origin=Debian,codename=${distro_codename},label=Debian-Security";
        "origin=Debian,codename=${distro_codename}-security,label=Debian-Security";
{% endif %}
};

// Coordinated / disruptive packages are upgraded only via their runbooks.
Unattended-Upgrade::Package-Blacklist {
{% for pkg in unattended_blacklist %}
        "{{ pkg }}";
{% endfor %}
};

// Never reboot on our own — forge-hypervisor would bounce every VM and
// forge-ops would take DNS + Traefik down. /var/run/reboot-required is the
// signal; `update.yml` reports it and Joseph reboots in the safe order.
Unattended-Upgrade::Automatic-Reboot "{{ unattended_automatic_reboot | ternary('true', 'false') }}";

Unattended-Upgrade::Remove-Unused-Kernel-Packages "{{ unattended_remove_unused_deps | ternary('true', 'false') }}";
Unattended-Upgrade::Remove-Unused-Dependencies "{{ unattended_remove_unused_deps | ternary('true', 'false') }}";

// Keep going if one package fails rather than abandoning the whole run.
Unattended-Upgrade::MinimalSteps "true";

Unattended-Upgrade::SyslogEnable "true";
Unattended-Upgrade::SyslogFacility "daemon";
