#!/usr/bin/env bash
# ============================================================
# bezaforge-backup-rsync.sh — managed by Ansible role: forge-ops-backup-rsync
#
# Runs nightly via systemd timer AFTER bezaforge-db-dumps.service.
# Mirrors each /opt/bezaforge/<service>/ into
# {{ backup_dest_root }}/<service>/data/ via rsync. Uses --delete
# so the mirror tracks the source — sanoid snapshots provide history.
#
# Exit code is non-zero if ANY service rsync fails. Systemd records
# the unit as failed; Prometheus node_exporter can alert on that.
#
# DO NOT EDIT THIS FILE BY HAND.
# Source of truth: ansible/roles/forge-ops-backup-rsync/templates/bezaforge-backup-rsync.sh.j2
# ============================================================

set -uo pipefail

SRC_ROOT="{{ backup_source_root }}"
DEST_ROOT="{{ backup_dest_root }}"

# Sanity check: the NFS mount must be live.
if ! mountpoint -q "${DEST_ROOT}"; then
    echo "FATAL: ${DEST_ROOT} is not a mountpoint. NFS down?" >&2
    exit 2
fi

# Baseline excludes that apply to every service.
BASE_EXCLUDES=(
    --exclude='*.tmp'
    --exclude='*.lock'
    --exclude='*.pid'
    --exclude='*.swp'
)

# Common rsync flags.
# -a    : archive (preserve perms, times, symlinks, etc.)
# -H    : preserve hard links
# -X    : preserve extended attributes
# --delete : remove dest files that are gone from source
# --numeric-ids : preserve raw uid/gid (don't try to map names)
# --info=stats1,progress2 : show summary at the end + light progress
RSYNC_FLAGS=(
    -aHX
    --delete
    --numeric-ids
    --info=stats1
)

failed=0
warned=0

# ------------------------------------------------------------
# rsync exit 24 is a WARNING, not a failure
# ------------------------------------------------------------
# 24 = "some files vanished before they could be transferred". Every
# service here is LIVE while this runs, and some rewrite their own files
# constantly — loki compacts and rotates chunks, prometheus churns its WAL.
# A file disappearing mid-transfer is normal operation, not data loss: the
# files that were copied were copied correctly, and --delete means the
# mirror tracks the source anyway.
#
# Treating 24 as failure produced a nightly "backup FAILED" alert on a
# backup that had succeeded (loki, 2026-08-09 02:52 — 637 MB transferred,
# every other service OK). That is worse than no alert: a channel that
# cries wolf is one you stop reading, and it costs you the next REAL
# backup failure. Warnings are surfaced loudly but do not fail the unit.
#
# Any OTHER non-zero code still fails: 23 (partial transfer / permissions),
# 12 (protocol error), 30 (timeout) and friends all mean something is
# genuinely wrong and the alert should fire.
{% for svc in backup_services %}
# --- {{ svc.name }} ---
{
    src="${SRC_ROOT}/{{ svc.name }}/"
    dest="${DEST_ROOT}/{{ svc.name }}/data/"
    if [[ ! -d "${src}" ]]; then
        echo "SKIP {{ svc.name }} — ${src} does not exist"
    else
        mkdir -p "${dest}"
        echo "==> {{ svc.name }}"
        rsync "${RSYNC_FLAGS[@]}" "${BASE_EXCLUDES[@]}" \
{% for excl in svc.excludes | default([]) %}
            --exclude='{{ excl }}' \
{% endfor %}
            "${src}" "${dest}"
        rc=$?
        case "${rc}" in
            0)
                echo "OK   {{ svc.name }}"
                ;;
            24)
                echo "WARN {{ svc.name }} — files vanished mid-transfer (rsync 24); copied data is intact, not a failure"
                warned=$((warned + 1))
                ;;
            *)
                echo "FAIL {{ svc.name }} (rsync exit ${rc})" >&2
                failed=$((failed + 1))
                ;;
        esac
    fi
}
{% endfor %}

if [[ ${failed} -ne 0 ]]; then
    echo "${failed} rsync(s) FAILED — see above." >&2
    exit 1
fi
if [[ ${warned} -ne 0 ]]; then
    echo "${warned} rsync(s) warned about vanished files (rsync 24) — expected for live services, not a failure."
fi
echo "All rsyncs completed at $(date -u +%Y-%m-%dT%H:%M:%SZ)."
