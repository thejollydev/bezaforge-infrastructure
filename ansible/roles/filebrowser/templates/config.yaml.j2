# {{ ansible_managed }}
# File Browser Quantum {{ filebrowser_version }}. Key reference: the
# release's frontend/public/config.generated.yaml.
http:
  port: {{ filebrowser_port }}
  listen: "0.0.0.0"
  externalUrl: "{{ filebrowser_external_url }}"
  # Safe only because nftables lets nothing but Traefik reach the port.
  trustProxyHeaders: true

server:
  database:
    path: "{{ filebrowser_state_dir }}/data/filebrowser.sqlite"
  cacheDir: "{{ filebrowser_state_dir }}/cache"
  cacheDirCleanup: true
  disableUpdateCheck: true
  filesystem:
    # Group-writable, matching the share's 0775 and Samba's masks.
    createFilePermission: "664"
    createDirectoryPermission: "775"
  sources:
    - path: "{{ filebrowser_share_path }}"
      name: files
      config:
        defaultEnabled: true
        # The template every new login's scope starts from: view and
        # download only. The owner's login gets write access once, by hand,
        # in Settings → User management (docs/runbooks/forge-files.md).
        defaultPermissions:
          view: true
          download: true
          modify: false
          create: false
          delete: false
          configured: true
        rules:
          # The live Google Drive mount: browsable, but never indexed.
          # Indexing walks every folder, and walking 470 GB of Drive
          # through rclone would page the whole Drive through its API.
          - folderPath: "/GoogleDrive"
            viewable: true
    # The nightly copy of Google Drive on bezapool, for getting back a
    # file that was deleted or changed in Drive. Mounted read-only, so the
    # same view-and-download permissions apply to every login, the owner's
    # included. It is local ZFS, not the Drive API, so indexing it is safe.
    - path: "{{ filebrowser_gdrive_replica_path }}"
      name: drive-replica
      config:
        defaultEnabled: true
        defaultPermissions:
          view: true
          download: true
          modify: false
          create: false
          delete: false
          configured: true
    # The laptop's ~/Projects, received one way by Syncthing, without its
    # secrets or build output (syncthing_projects_ignore_patterns).
    # Read-only like the replica.
    - path: "{{ filebrowser_projects_path }}"
      name: projects
      config:
        defaultEnabled: true
        defaultPermissions:
          view: true
          download: true
          modify: false
          create: false
          delete: false
          configured: true

auth:
  adminUsername: "{{ filebrowser_admin_user }}"
  # adminPassword comes from FILEBROWSER_ADMIN_PASSWORD in the service's
  # environment file, not from here.
  methods:
    password:
      enabled: true
      minLength: 12
      signup: false

frontend:
  name: "BezaForge Files"
