# OpenProject .env — rendered from roles/openproject/templates/env.j2
# Secrets sourced from ansible-vault (host_vars/forge-ops/vault.yml).
#
# NOTE: this file feeds TWO consumers:
#   1. docker compose variable interpolation (OPENPROJECT_RELEASE +
#      OPENPROJECT_HOST are read from ./.env for the image tag and
#      the Traefik Host() label).
#   2. the container's environment (env_file), where OpenProject
#      reads its OPENPROJECT_* settings.

# --- compose interpolation ---
OPENPROJECT_RELEASE={{ openproject_release }}
OPENPROJECT_HOST={{ openproject_host }}

# --- app config ---
OPENPROJECT_HOST__NAME={{ openproject_host }}
# TLS terminates at Traefik; force https URL generation + HSTS.
OPENPROJECT_HTTPS=true
OPENPROJECT_HSTS=true

# Rails secret (>= 30 chars random hex). Immutable once set —
# rotating it invalidates sessions/cookies. Must be the RAW Rails
# var name SECRET_KEY_BASE (NOT OPENPROJECT_-prefixed — that prefix
# is only for OpenProject's own settings; the raw name is what the
# entrypoint's insecure-default check reads).
SECRET_KEY_BASE={{ openproject_secret_key_base }}

# Seed the built-in admin on first boot. RESET=false so re-runs
# don't clobber a password you've since changed in the UI.
OPENPROJECT_SEED_ADMIN_USER_PASSWORD={{ openproject_admin_password }}
OPENPROJECT_SEED_ADMIN_USER_PASSWORD__RESET=false

# ⚠️ WORKING DAYS — all seven, deliberately.
# OpenProject ships `working_days` defaulting to [1,2,3,4,5] (Mon-Fri) and
# SILENTLY REWRITES any date that lands on a non-working day: a due date set
# to Saturday 2026-08-15 came back as Monday 2026-08-17, with no warning and
# no indication in the API response that it had been moved. Most of the work
# tracked here happens on weekends, so the stock default is wrong for
# this instance and quietly corrupts scheduling.
#
# Set here rather than in the UI/DB because an OPENPROJECT_ env var
# OVERRIDES the database value — verified 2026-08-14 by running one
# throwaway process in the container with a different value ([1,2,3]) and
# watching it win over the DB's [1,2,3,4,5,6,7]. That makes this
# rebuild-safe: a from-scratch OpenProject gets weekends as working days
# without anyone remembering to re-set it.
#
# ⛔ The value MUST be a JSON array. Comma-separated (`1,2,3`) raises during
# settings load and kills the process — also verified, in the same probe.
# Authoritative env name from `Settings::Definition[:working_days].possible_env_names`.
OPENPROJECT_WORKING__DAYS=[1,2,3,4,5,6,7]

# YJIT is ON — the Rails default. OPENPROJECT_DISABLE__YJIT is deliberately
# absent (#1590, ADR 0013's second stage, watched until 2026-11-08).
#
# History, so this is not re-litigated: YJIT was switched off on 2026-08-15
# after a web-tier segfault whose innermost C frame was rb_yjit_iseq_mark (#679).
# With YJIT verified off, Ruby 4.0.2 still segfaulted 11 more times (2026-09-03,
# -06, -21), so the fault was the VM, not the JIT. 17.8.0 moved to Ruby 4.0.6
# with YJIT still off, one variable at a time, and ran clean for the three-week
# watch to 2026-10-18. This turns YJIT back on as the separate second step.
# If crashes return only with YJIT on, put the line below back and record why:
#   OPENPROJECT_DISABLE__YJIT=true
#
# ⚠️ THE KNOB IS NOT RUBYOPT AND NOT A RUBY DEFAULT. `ruby -v` inside the
# container prints `+PRISM` with NO `+YJIT` either way — YJIT is switched on
# programmatically by Rails at boot:
#   config/initializers/new_framework_defaults_7_2.rb:75
#   Rails.application.config.yjit = ENV["OPENPROJECT_DISABLE__YJIT"] != "true"
# The double underscore is OpenProject's nested-setting convention and is
# required. An earlier RUBYOPT=--disable-yjit attempt was proven inert.
#
# Verify AFTER applying (the value must be read by a real app process):
#   docker exec <c> bash -c "cd /app && RAILS_ENV=production \
#     bundle exec rails runner 'puts RubyVM::YJIT.enabled?'"   # => true
# ⛔ `docker restart` REUSES the existing container env — it cannot pick a
# change here up. Compose must recreate the container (`state: present` does,
# because env_file is part of its config hash; force with
# `docker compose up -d --force-recreate` if the check above disagrees).
#
# ⚠️ A CRASH HERE IS INVISIBLE FROM CONTAINER STATE. The all-in-one bundles
# Postgres + web and PID 1 is apache2ctl, which never dies — so on 2026-08-15
# `docker ps` read "Up 11 hours" while Apache accepted on 8080 with zero Puma
# workers behind it. Requests HUNG instead of being refused. Only an HTTP check
# catches it (#676), and core dumps now alert (#1282).

# Modest thread pool for a single-user pilot host.
RAILS_MIN_THREADS=2
RAILS_MAX_THREADS=6
