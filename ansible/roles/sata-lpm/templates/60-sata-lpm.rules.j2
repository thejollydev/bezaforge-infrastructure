# ============================================================
# 60-sata-lpm.rules — managed by Ansible role: sata-lpm
# DO NOT EDIT THIS FILE BY HAND.
# ============================================================
# Pins every SATA host's link power management policy. The kernel default
# (med_power_with_dipm on occupied ports) lets the bezapool WD Reds drop
# their links on power-state wake — see the role's defaults/main.yml and
# work package #1101 for the full story.
ACTION=="add", SUBSYSTEM=="scsi_host", KERNEL=="host*", ATTR{link_power_management_policy}="{{ sata_lpm_policy }}"
