#!/usr/bin/env bash
# {{ ansible_managed }} — roles/deploy-stamp/templates/deploy-stamp-metric.sh.j2 (#671)
#
# Publishes this host's per-role deploy stamps as node_exporter textfile
# metrics, so "which commit is this host actually running for role X" is a
# question Prometheus can answer instead of one somebody has to ask by
# hand during an incident.
#
# Reads every file in the stamp directory rather than being handed the
# roles that just ran: a tag-scoped deploy updates two stamps and must not
# erase the other thirty. The stamp directory is the state; this is only
# its projection.
#
# ⚠️ THE LABEL IS `ansible_role`, NOT `role`. DO NOT "SIMPLIFY" IT.
# Prometheus target labels WIN over metric labels: when a scraped series
# carries a label the scrape config also sets, the metric's own value is
# renamed to `exported_<label>` and the target's value takes the name.
# prometheus.yml sets `role:` on three jobs — forge-ops (docker-host),
# forge-hypervisor (hypervisor) and forge-brizza (assistant-host) — so a
# `role` label here was silently rewritten on exactly those three hosts.
# Every stamp was written correctly; they just arrived in Prometheus
# labelled `role="docker-host"` with the real name hidden in
# `exported_role`. The drift check then found no such role in git and
# skipped them, reporting CURRENT while the three busiest hosts were
# unmonitored — a false green, the precise failure #671 exists to kill.
# Found 2026-08-14 on the first live verification. `ansible_role` cannot
# collide with anything in prometheus.yml.

set -uo pipefail

STAMP_DIR="{{ deploy_stamp_dir }}"
OUT="{{ deploy_stamp_metric_file }}"
TMP="${OUT}.$$"

emit() {
    cat <<'EOF'
# HELP bezaforge_role_deployed_commit_timestamp_seconds Committer timestamp of the repo HEAD this role was last deployed from.
# TYPE bezaforge_role_deployed_commit_timestamp_seconds gauge
EOF
    for f in "${STAMP_DIR}"/*; do
        [ -f "${f}" ] || continue
        # shellcheck disable=SC1090
        role="" commit_ts="" sha="" branch="" dirty=""
        while IFS='=' read -r k v; do
            case "${k}" in
                role) role="${v}" ;;
                commit_ts) commit_ts="${v}" ;;
                sha) sha="${v}" ;;
                branch) branch="${v}" ;;
                dirty) dirty="${v}" ;;
            esac
        done < "${f}"
        [ -n "${role}" ] && [ -n "${commit_ts}" ] || continue
        printf 'bezaforge_role_deployed_commit_timestamp_seconds{ansible_role="%s"} %s\n' \
            "${role}" "${commit_ts}"
    done

    # ⚠️ RENAMED IN #819, not redefined — the name change is the point.
    # This was bezaforge_role_deployed_timestamp_seconds, "when the role
    # last ran", fed by a `deployed_ts` field that roles/deploy-stamp wrote
    # from `date +%s` on every run — which made the stamp task report
    # `changed` every run on every host and cost the fleet its idempotency
    # gate for nine days. The replacement is the stamp file's mtime, which
    # is a DIFFERENT QUANTITY, so it gets a different name: reusing the old
    # one would leave a single Prometheus series holding two incompatible
    # meanings either side of the cutover, and any range query spanning it
    # would silently average them. Nothing consumed the old series — no
    # dashboard, no rule in alert-rules.yaml, and not
    # scripts/deploy-drift-check.py — so it is simply gone.
    #
    # ⛔ DO NOT ALERT ON THIS AS STALENESS. It measures when the stamp's
    # CONTENT last changed, so for a healthy role that nobody has needed to
    # redeploy the value is SUPPOSED to sit still, possibly for months. The
    # obvious `time() - <this> > 7d` would fire for every converged role on
    # the fleet. "When did this role last run" is deliberately not recorded
    # anywhere: recording it requires writing on every run, which is the
    # #819 defect itself. Deployed-vs-main is what actually matters and
    # bezaforge_role_deployed_commit_timestamp_seconds above already
    # answers it.
    #
    # ⚠️ It is stamp CONTENT, not the deployed commit. mtime advances when
    # only `branch` or `dirty` changes at an identical SHA, and does NOT
    # advance when `copy` repairs owner/group/mode without rewriting bytes.
    cat <<'EOF'
# HELP bezaforge_role_stamp_mtime_seconds Mtime of this role's stamp file — when the stamp CONTENT last changed on this host. Not when the role last ran, and not a staleness signal; see #819.
# TYPE bezaforge_role_stamp_mtime_seconds gauge
EOF
    for f in "${STAMP_DIR}"/*; do
        [ -f "${f}" ] || continue
        role="" mtime=""
        while IFS='=' read -r k v; do
            case "${k}" in
                role) role="${v}" ;;
            esac
        done < "${f}"
        mtime="$(stat -c %Y "${f}" 2>/dev/null || true)"
        [ -n "${role}" ] && [ -n "${mtime}" ] || continue
        printf 'bezaforge_role_stamp_mtime_seconds{ansible_role="%s"} %s\n' \
            "${role}" "${mtime}"
    done

    # 1 means the control node had modified tracked files when this role
    # was applied, so `sha` does NOT describe what is running. The drift
    # check reports that as INVALID rather than believing the stamp — an
    # exporter that cannot measure must never emit a healthy value.
    cat <<'EOF'
# HELP bezaforge_role_deployed_dirty 1 if this role was deployed from a dirty working tree, so its recorded SHA cannot be trusted.
# TYPE bezaforge_role_deployed_dirty gauge
EOF
    for f in "${STAMP_DIR}"/*; do
        [ -f "${f}" ] || continue
        role="" dirty=""
        while IFS='=' read -r k v; do
            case "${k}" in
                role) role="${v}" ;;
                dirty) dirty="${v}" ;;
            esac
        done < "${f}"
        [ -n "${role}" ] || continue
        printf 'bezaforge_role_deployed_dirty{ansible_role="%s"} %s\n' \
            "${role}" "${dirty:-0}"
    done

    # An info-style series so a human reading Prometheus can see the actual
    # commit, not just an epoch. Value is always 1; the labels are the data.
    cat <<'EOF'
# HELP bezaforge_role_deployed_sha_info The commit and branch this role was last deployed from. Always 1; the labels carry the information.
# TYPE bezaforge_role_deployed_sha_info gauge
EOF
    for f in "${STAMP_DIR}"/*; do
        [ -f "${f}" ] || continue
        role="" sha="" branch=""
        while IFS='=' read -r k v; do
            case "${k}" in
                role) role="${v}" ;;
                sha) sha="${v}" ;;
                branch) branch="${v}" ;;
            esac
        done < "${f}"
        [ -n "${role}" ] && [ -n "${sha}" ] || continue
        # Strip anything that would break the exposition format. Branch
        # names may legally contain characters a label value may not.
        branch="${branch//\"/}"
        branch="${branch//\\/}"
        printf 'bezaforge_role_deployed_sha_info{ansible_role="%s",sha="%s",branch="%s"} 1\n' \
            "${role}" "${sha}" "${branch}"
    done
}

# Write-then-rename: node_exporter reads this directory continuously and a
# partially-written file scrapes as truncated garbage. rename(2) on the
# same filesystem is atomic — a scrape sees the old file or the new one,
# never half of one.
emit > "${TMP}"
chmod 0644 "${TMP}"
mv -f "${TMP}" "${OUT}"
