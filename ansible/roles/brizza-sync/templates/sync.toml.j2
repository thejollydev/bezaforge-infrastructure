# Managed by Ansible (roles/brizza-sync). Edits here are overwritten.

state = "{{ brizza_sync_home }}/{{ brizza_sync_state_dir }}/state.db"

hermes = "{{ brizza_sync_home }}/.local/bin/hermes"
never4ga = "{{ brizza_sync_never4ga }}"
actor = "{{ brizza_sync_actor }}"
assignee = "{{ brizza_sync_assignee }}"

[statuses]
approved = "{{ brizza_sync_status_approved }}"
started = "{{ brizza_sync_status_started }}"
awaiting_approval = "{{ brizza_sync_status_awaiting_approval }}"
closed = "{{ brizza_sync_status_closed }}"
ended = {{ brizza_sync_statuses_ended | to_json }}
{% for project in brizza_sync_projects %}

[[projects]]
name = "{{ project.name }}"
path = "{{ project.path }}"
board = "{{ project.board | default('default') }}"
{% endfor %}
