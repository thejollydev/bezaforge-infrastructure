#!/usr/bin/env bash
# Managed by Ansible (roles/hermes-team). Local edits are overwritten.
#
# Move Hermes to its newest published release. Run nightly by
# hermes-update.timer and on every deploy.
#
# Why this exists instead of `hermes update`: Hermes' own updater follows a
# BRANCH (main by default) — it fetches origin/<branch> and resets to it,
# so it cannot target a release tag, and upstream keeps no branch that
# tracks releases. Joseph chose releases over main (2026-09-18), so this
# script decides WHICH code, and hands everything it can to Hermes' own
# commands.
#
# Exit codes: 0 = already current or updated; 1 = update failed and was
# rolled back; 2 = could not even determine the newest release. A non-zero
# exit leaves hermes-update.service failed, which the fleet's failed-unit
# alert reports — a night the update did not happen is never silent.

#
# HOW A RELEASE IS INSTALLED IS THE RELEASE'S OWN BUSINESS. From v0.21.6
# Hermes installs itself through its own package manager (pm/), on a Python
# it downloads, and publishes the `hermes` command itself. This script used
# to reproduce the installer's dependency step by hand, and stopped working
# the day that step changed. It now runs the stages of the installer that
# ships IN the release it has just checked out, so the next change to how
# Hermes installs itself arrives with the release. A release from before
# the package manager is still installed the old way, which is what a
# rollback to one needs.

set -euo pipefail
unset PYTHONPATH PYTHONHOME

CHECKOUT="{{ hermes_checkout }}"
HERMES="{{ hermes_bin }}"
HERMES_DATA="{{ hermes_home }}/.hermes"
LAUNCHERS="{{ hermes_home }}/.local/bin"
UV="{{ hermes_home }}/.hermes/bin/uv"
API="{{ hermes_latest_release_api }}"

log() { printf '%s %s\n' "$(date -Is)" "$*"; }

latest="$(curl -fsS --max-time 60 "$API" | python3 -c 'import json,sys; print(json.load(sys.stdin)["tag_name"])')" || {
    log "could not read the newest release from $API"; exit 2; }
[ -n "$latest" ] || { log "the release API returned no tag"; exit 2; }

current="$(git -C "$CHECKOUT" describe --tags --exact-match HEAD 2>/dev/null || echo "none")"
if [ "$current" = "$latest" ]; then
    log "hermes is at the newest release, $latest — nothing to do"
    exit 0
fi

previous_sha="$(git -C "$CHECKOUT" rev-parse HEAD)"
log "updating hermes: $current -> $latest"

# Whether the tree now checked out installs itself through pm.
tree_uses_pm() {
    [ -f "$CHECKOUT/pm/cli.py" ] && [ -f "$CHECKOUT/scripts/install.sh" ]
}

# One stage of the checked-out release's own installer, with no terminal so
# nothing can wait on a question. `python-deps` builds the environment
# through pm; `products` publishes the hermes command, builds the apps and
# syncs bundled skills, and is what upstream calls "the completion an update
# calls". `prerequisites` is not run: it reaches for sudo, and the role
# installs those packages as root.
installer_stage() {
    setsid --wait env HERMES_HOME="$HERMES_DATA" \
        bash "$CHECKOUT/scripts/install.sh" \
            --dir "$CHECKOUT" --hermes-home "$HERMES_DATA" \
            --non-interactive --stage "$1" </dev/null
}

# A release from before pm: the old installer's dependency step, reproduced
# (run_locked_uv_sync in that release's scripts/install.sh).
#   UV_PYTHON pins uv to the old venv's Python. Without it uv finds the
#     host's newer Python and rebuilds the venv on it.
#   --locked verifies every package against the SHA-256 recorded in that
#     release's lockfile.
# pm builds its environment elsewhere and leaves this venv alone (measured
# on forge-agents 2026-10-09), which is what makes a rollback possible.
sync_dependencies_before_pm() {
    local isolated
    isolated="$(mktemp -d)"
    (
        cd "$CHECKOUT"
        unset UV_NO_CONFIG UV_CONFIG_FILE
        export XDG_CONFIG_HOME="$isolated" XDG_CONFIG_DIRS="$isolated"
        export UV_PYTHON="$CHECKOUT/venv/bin/python"
        UV_PROJECT_ENVIRONMENT="$CHECKOUT/venv" "$UV" sync --extra all --locked
    )
    local rc=$?
    rmdir "$isolated" 2>/dev/null || true
    return "$rc"
}

# Install whatever release is checked out, the way that release installs.
install_checked_out_release() {
    if tree_uses_pm; then
        installer_stage python-deps && installer_stage products
    else
        sync_dependencies_before_pm
    fi
}

# What an update changes outside the checkout, kept so a rollback can put
# it back:
#   the `hermes` commands in ~/.local/bin. pm's `products` stage rewrites
#     them to point at its own environment, and a release from before pm
#     needs the old ones.
#   every config.yaml. A release migrates their format as it installs (v46
#     to v50 at v0.21.6, measured), and the release being rolled back to
#     has never seen the new one.
saved_state="$(mktemp -d)"
trap 'rm -rf "$saved_state"' EXIT
save_state() {
    local f rel
    mkdir -p "$saved_state/launchers" "$saved_state/config"
    for f in hermes hermes-acp hermes-agent; do
        [ -f "$LAUNCHERS/$f" ] && cp -p "$LAUNCHERS/$f" "$saved_state/launchers/$f"
    done
    for f in "$HERMES_DATA/config.yaml" "$HERMES_DATA"/profiles/*/config.yaml; do
        [ -f "$f" ] || continue
        rel="${f#"$HERMES_DATA"/}"
        mkdir -p "$saved_state/config/$(dirname "$rel")"
        cp -p "$f" "$saved_state/config/$rel"
    done
    return 0
}
restore_state() {
    local f rel
    for f in hermes hermes-acp hermes-agent; do
        [ -f "$saved_state/launchers/$f" ] && cp -p "$saved_state/launchers/$f" "$LAUNCHERS/$f"
    done
    [ -d "$saved_state/config" ] || return 0
    while IFS= read -r f; do
        rel="${f#"$saved_state/config"/}"
        cp -p "$f" "$HERMES_DATA/$rel"
    done < <(find "$saved_state/config" -type f -name config.yaml)
    return 0
}

# Settings that a release retires or renames. Run with no terminal so any
# question takes its default instead of waiting for someone at 4 a.m.
#
# Every profile that EXISTS, read from disk rather than from the roster: a
# deploy that adds an agent runs this before it creates that agent's
# profile, and migrating a profile that is not there yet would fail — and
# roll back a good update — for no reason.
migrate_configs() {
    setsid --wait "$HERMES" config migrate </dev/null
    local dir
    for dir in "{{ hermes_profiles_dir }}"/*/; do
        [ -f "$dir/config.yaml" ] || continue
        setsid --wait "$HERMES" -p "$(basename "$dir")" config migrate </dev/null
    done
}

# One gateway serves the whole team (Brizza ADR-0024), and it is restarted
# only if it is already running: an update is no reason to start it. A
# parked agent stays parked across the restart.
#
# Through `hermes gateway restart`, not systemctl alone: the unit file names
# the interpreter Hermes runs on, and that path moves when a release moves
# to pm (or back). Hermes' own restart rewrites the unit when its generated
# definition has changed, then restarts. systemctl is the fallback, so a
# failure there still leaves the gateway bounced.
restart_running_agents() {
    systemctl --user is-active --quiet '{{ hermes_gateway_unit }}' || return 0
    setsid --wait "$HERMES" -p default gateway restart </dev/null \
        || systemctl --user try-restart '{{ hermes_gateway_unit }}' \
        || true
}

rollback() {
    log "update to $latest FAILED at: $1 — rolling back to ${current} (${previous_sha:0:12})"
    git -C "$CHECKOUT" checkout --quiet --detach "$previous_sha" \
        && restore_state \
        && install_checked_out_release \
        && restart_running_agents \
        && log "rolled back; hermes is at $current again" \
        || log "ROLLBACK ALSO FAILED — hermes may be half-updated; run the playbook to repair"
    exit 1
}

# A shallow checkout: fetch just the new release's commit and name its tag
# locally, rather than pulling history or the thousands of upstream
# branches.
git -C "$CHECKOUT" fetch --quiet --depth 1 origin "refs/tags/$latest:refs/tags/$latest" || rollback "fetching $latest"
save_state
git -C "$CHECKOUT" checkout --quiet --detach "$latest"                                   || rollback "checking out $latest"
install_checked_out_release                                                              || rollback "installing $latest"
migrate_configs                                                                          || rollback "migrating configuration"
"$HERMES" --version >/dev/null                                                           || rollback "starting the new version"
restart_running_agents

log "hermes updated to $latest ($("$HERMES" --version 2>&1 | head -1))"
